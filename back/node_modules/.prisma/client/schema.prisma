generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
}

model Produto {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String
  estoque   Int

  movimentacoes Movimentacao[]
}

model Movimentacao {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  quantidade Int
  date       DateTime

  status Status @default(PEDIDO)

  produto Produto @relation(fields: [produtoId], references: [id])
}

enum Status {
  PEDIDO
  PRODUZIDO
}
